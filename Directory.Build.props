<Project>
  <PropertyGroup>
    <ResticBrowserProductVersion>3.0.9</ResticBrowserProductVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ResticBrowserAssemblyVersion>$(ResticBrowserProductVersion).0</ResticBrowserAssemblyVersion>
  </PropertyGroup>
</Project>
