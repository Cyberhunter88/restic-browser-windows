<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResticBrowser</AssemblyName>
    <RootNamespace>ResticBrowser</RootNamespace>
    <Version>0.3.2</Version>
    <AssemblyVersion>0.3.2.0</AssemblyVersion>
    <FileVersion>0.3.2.0</FileVersion>
    <InformationalVersion>0.3.2</InformationalVersion>
    <Product>Restic Browser</Product>
    <AssemblyTitle>Restic Browser – Restic-Repository-Browser</AssemblyTitle>
    <Description>Grafische Anwendung zum Durchsuchen und Wiederherstellen von Restic-Backups</Description>
    <Authors>Cyberhunter88</Authors>
    <Company>Restic Browser</Company>
    <Copyright>Copyright © 2026 Cyberhunter88</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app-icon.png" />
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>
  <PropertyGroup>
    <RemoteHelperPublishDirectory>$(MSBuildProjectDirectory)\obj\remote-helper\$(Configuration)\</RemoteHelperPublishDirectory>
    <RemoteHelperPublishFile>$(RemoteHelperPublishDirectory)ResticBrowser.Remote</RemoteHelperPublishFile>
  </PropertyGroup>
  <ItemGroup>
    <RemoteHelperSource Include="$(MSBuildProjectDirectory)\..\ResticBrowser.Remote\**\*.cs"
                        Exclude="$(MSBuildProjectDirectory)\..\ResticBrowser.Remote\bin\**;$(MSBuildProjectDirectory)\..\ResticBrowser.Remote\obj\**" />
    <RemoteHelperSource Include="$(MSBuildProjectDirectory)\..\ResticBrowser.Remote\ResticBrowser.Remote.csproj" />
    <RemoteHelperSource Include="$(MSBuildProjectDirectory)\Remote\RemoteProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RemoteHelperPublishFile)"
                      LogicalName="ResticBrowser.Remote.linux-x64" />
  </ItemGroup>
  <Target Name="PublishEmbeddedRemoteHelper"
          BeforeTargets="PrepareResources"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(RemoteHelperSource)"
          Outputs="$(RemoteHelperPublishFile)">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ResticBrowser.Remote\ResticBrowser.Remote.csproj&quot; -c &quot;$(Configuration)&quot; -r linux-x64 --self-contained true --no-restore -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -o &quot;$(RemoteHelperPublishDirectory)&quot;" />
  </Target>
</Project>
