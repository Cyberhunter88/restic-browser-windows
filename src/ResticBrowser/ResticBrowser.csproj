<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'linux-x64'">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResticBrowser</AssemblyName>
    <RootNamespace>ResticBrowser</RootNamespace>
    <Version>$(ResticBrowserProductVersion)</Version>
    <AssemblyVersion>$(ResticBrowserAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ResticBrowserAssemblyVersion)</FileVersion>
    <InformationalVersion>$(ResticBrowserProductVersion)</InformationalVersion>
    <Product>Restic Browser</Product>
    <AssemblyTitle>Restic Browser – Restic-Repository-Browser</AssemblyTitle>
    <Description>Grafische Anwendung zum Durchsuchen und Wiederherstellen von Restic-Backups</Description>
    <Authors>Cyberhunter88</Authors>
    <Company>Restic Browser</Company>
    <Copyright>Copyright © 2026 Cyberhunter88</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app-icon.png" />
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>
  <PropertyGroup>
    <EmbeddedResticDirectory>$(BaseIntermediateOutputPath)restic/win-x64/</EmbeddedResticDirectory>
    <EmbeddedResticFile>$(EmbeddedResticDirectory)restic.exe</EmbeddedResticFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(EmbeddedResticFile)"
                      LogicalName="ResticBrowser.EmbeddedRestic.win-x64"
                      Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <ResticBundleSource Include="$(MSBuildProjectDirectory)/../../build/restic-manifest.json" />
    <ResticBundleSource Include="$(MSBuildProjectDirectory)/../../build/restic-signing-key.asc" />
    <ResticBundleSource Include="$(MSBuildProjectDirectory)/../../scripts/prepare-restic.ps1" />
  </ItemGroup>
  <Target Name="PrepareEmbeddedRestic"
          BeforeTargets="PrepareResources"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(ResticBundleSource)"
          Outputs="$(EmbeddedResticFile)">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/prepare-restic.ps1&quot; -Platform windows -Destination &quot;$(EmbeddedResticFile)&quot;" />
  </Target>
</Project>
