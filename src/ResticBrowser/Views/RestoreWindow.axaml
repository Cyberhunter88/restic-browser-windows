<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ResticBrowser.Views.RestoreWindow" Title="Wiederherstellung" Width="590" Height="430" MinWidth="500" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
    <TextBlock Text="Wiederherstellen" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="7"><TextBox x:Name="TargetBox" PlaceholderText="Zielordner" /><Button Grid.Column="1" Content="Auswählen …" Click="Browse_Click" /></Grid>
    <ComboBox x:Name="OverwriteBox" Grid.Row="3" SelectedIndex="0"><ComboBoxItem Tag="Never">Nie überschreiben (empfohlen)</ComboBoxItem><ComboBoxItem Tag="IfNewer">Nur überschreiben, wenn Backup-Datei neuer ist</ComboBoxItem><ComboBoxItem Tag="IfChanged">Überschreiben, wenn Inhalt geändert ist</ComboBoxItem><ComboBoxItem Tag="Always">Immer überschreiben</ComboBoxItem></ComboBox>
    <StackPanel Grid.Row="4" Spacing="8"><ProgressBar x:Name="RestoreProgressBar" Minimum="0" Maximum="100" /><TextBlock x:Name="ProgressText" Text="Bereit" Foreground="{DynamicResource TextSecondary}" /><TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" IsVisible="False" MinHeight="70" /></StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="OpenButton" Content="Zielordner öffnen" Click="Open_Click" IsVisible="False" /><Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click" /><Button x:Name="RestoreButton" Classes="primary" Content="Wiederherstellen" Click="Restore_Click" /></StackPanel>
  </Grid>
</Window>
