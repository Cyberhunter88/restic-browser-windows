<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ResticBrowser.Views.RestoreWindow" Title="Wiederherstellung"
        Width="700" Height="650" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
    <TextBlock Text="Wiederherstellen" Classes="title" />
    <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
    <Border Grid.Row="2" Classes="panel" Padding="10,8">
      <StackPanel Spacing="3">
        <TextBlock Text="Auswahl:" FontWeight="SemiBold"/>
        <TextBlock x:Name="SelectionDetailsText" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="7">
      <TextBox x:Name="TargetBox" PlaceholderText="Zielordner" TextChanged="PreviewInputChanged" />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="Auswählen …" Click="Browse_Click" />
    </Grid>
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
      <ComboBox x:Name="OverwriteBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="PreviewInputChanged">
        <ComboBoxItem Tag="Never">Nie überschreiben (empfohlen)</ComboBoxItem>
        <ComboBoxItem Tag="IfNewer">Nur überschreiben, wenn Backup-Datei neuer ist</ComboBoxItem>
        <ComboBoxItem Tag="IfChanged">Überschreiben, wenn Inhalt geändert ist</ComboBoxItem>
        <ComboBoxItem Tag="Always">Immer überschreiben</ComboBoxItem>
      </ComboBox>
      <ProgressBar x:Name="RestoreProgressBar" Grid.Row="1" Minimum="0" Maximum="100" />
      <TextBlock x:Name="ProgressText" Grid.Row="2" Text="Bereit" Foreground="{DynamicResource TextSecondary}" />
      <TextBox x:Name="ResultBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="False" MinHeight="70" />
    </Grid>
    <WrapPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" ItemHeight="32">
      <Button x:Name="OpenButton" Content="Zielordner öffnen" Click="Open_Click" IsVisible="False" />
      <Button x:Name="PreviewButton" Content="Vorschau prüfen" Click="PreviewRestore_Click" />
      <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click" />
      <Button x:Name="RestoreButton" Classes="primary" Content="Wiederherstellen" Click="Restore_Click" />
    </WrapPanel>
  </Grid>
</Window>
