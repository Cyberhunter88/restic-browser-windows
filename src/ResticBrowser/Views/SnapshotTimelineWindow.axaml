<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ResticBrowser.Models"
        x:Class="ResticBrowser.Views.SnapshotTimelineWindow" Title="Snapshot-Zeitachse" Width="850" Height="560" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="Snapshot-Zeitachse" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Alle Sicherungen nach Zeitpunkt, Host und Pfad. Ein Doppelklick wählt den Snapshot im Hauptfenster." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid x:Name="TimelineGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" DoubleTapped="Timeline_DoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Time, StringFormat={}{0:g}}" Width="180"/>
        <DataGridTextColumn Header="Host" Binding="{Binding Hostname}" Width="150"/>
        <DataGridTextColumn Header="Pfade" Binding="{Binding PathText}" Width="*"/>
        <DataGridTextColumn Header="Tags" Binding="{Binding TagText}" Width="150"/>
        <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
    <Button Grid.Row="2" HorizontalAlignment="Right" Content="Schließen" Click="Close_Click"/>
  </Grid>
</Window>
