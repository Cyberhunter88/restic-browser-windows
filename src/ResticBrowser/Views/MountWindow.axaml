<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ResticBrowser.Views.MountWindow"
        Title="Als Laufwerk einbinden"
        Width="620" Height="640" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <StackPanel Spacing="4">
      <TextBlock Text="Als Laufwerk einbinden" Classes="title" />
      <TextBlock Text="Sicherungen direkt im Dateimanager durchsuchen. Das Repository bleibt unverändert."
                 Classes="secondary" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Ansicht im Dateimanager" Classes="sectionTitle" />
            <StackPanel Spacing="6">
              <RadioButton x:Name="RadioSingleSnapshot" IsChecked="True" GroupName="MountScope">
                <TextBlock Text="Ausgewählter Snapshot" TextWrapping="Wrap" />
              </RadioButton>
              <TextBlock x:Name="SnapshotInfoText" Margin="28,0,0,0" Classes="secondary small" TextWrapping="Wrap" />
            </StackPanel>
            <RadioButton x:Name="RadioAllSnapshots" GroupName="MountScope">
              <TextBlock Text="Übersicht aller Snapshots" TextWrapping="Wrap" />
            </RadioButton>

            <TextBlock Text="Restic bindet das Repository lesend ein. Die Auswahl bestimmt den geöffneten Ordner."
                       Classes="secondary small" TextWrapping="Wrap" />
            <Separator Margin="0,2" />
            <TextBlock Text="Zielordner" Classes="sectionTitle" />
            <TextBlock Text="Wähle einen leeren lokalen Ordner außerhalb des Repositorys."
                       Classes="secondary small" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <ComboBox x:Name="DriveLetterCombo" HorizontalAlignment="Stretch" />
              <TextBox x:Name="CustomPathBox" IsVisible="False" PlaceholderText="Absoluter Pfad zum Zielordner" />
              <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="Ordner auswählen …"
                      Classes="quiet" IsVisible="False" Click="BrowseFolder_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock x:Name="StatusTitleText" Text="Bereit zum Einbinden" Classes="sectionTitle" />
            <TextBlock x:Name="StatusText" Text="Wähle die Sicherungen und einen Zielordner."
                       TextWrapping="Wrap" Classes="secondary" />
            <Button x:Name="RepairMountButton" Content="Alte Einbindung trennen" Classes="quiet"
                    IsVisible="False" Click="RepairMount_Click" HorizontalAlignment="Left" />
            <ProgressBar x:Name="MountProgressBar" IsIndeterminate="True" IsVisible="False" Height="4" />
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="OpenExplorerButton" Content="Im Dateimanager öffnen" Classes="quiet"
                      Click="OpenExplorer_Click" IsEnabled="False" Margin="0,4,8,0" />
              <Button x:Name="UnmountButton" Content="Einbindung trennen" Classes="quiet"
                      Click="Unmount_Click" IsEnabled="False" Margin="0,4,0,0" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CloseButton" Content="Schließen" Classes="quiet" Click="Close_Click" />
      <Button x:Name="MountButton" Classes="primary" Content="Einbinden" Click="Mount_Click" />
    </StackPanel>
  </Grid>
</Window>
