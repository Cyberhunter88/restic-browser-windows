<Window x:Class="ResticBrowser.Views.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auswahl wiederherstellen" Width="610" Height="510" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Auswahl wiederherstellen" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,5,0,18" Foreground="{DynamicResource TextSecondary}"/>
    <StackPanel Grid.Row="2">
      <TextBlock Text="Zielordner"/>
      <DockPanel Margin="0,5,0,12">
        <Button DockPanel.Dock="Right" Content="Auswählen …" Click="Browse_Click"/>
        <TextBox x:Name="TargetBox"/>
      </DockPanel>
      <TextBlock Text="Vorhandene Dateien"/>
      <ComboBox x:Name="OverwriteBox" Margin="0,5,0,10" SelectedIndex="0">
        <ComboBoxItem Tag="Never">Nie überschreiben (empfohlen)</ComboBoxItem>
        <ComboBoxItem Tag="IfNewer">Nur überschreiben, wenn Backup-Datei neuer ist</ComboBoxItem>
        <ComboBoxItem Tag="IfChanged">Überschreiben, wenn Inhalt geändert ist</ComboBoxItem>
        <ComboBoxItem Tag="Always">Immer überschreiben</ComboBoxItem>
      </ComboBox>
      <TextBlock Text="Die ursprüngliche Verzeichnisstruktur wird unterhalb des Zielordners erhalten."
                 TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,18,0,0">
      <ProgressBar x:Name="RestoreProgressBar" Height="7" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="ProgressText" Margin="0,8,0,0" Text="Bereit" Foreground="{DynamicResource TextSecondary}"/>
    </StackPanel>
    <TextBox x:Name="ResultBox" Grid.Row="4" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap"
             Visibility="Collapsed" Background="{DynamicResource PanelAltBackground}"/>
    <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="OpenButton" Content="Zielordner öffnen" Click="Open_Click" Visibility="Collapsed"/>
      <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click"/>
      <Button x:Name="RestoreButton" Content="Wiederherstellen" Style="{StaticResource PrimaryButton}" Click="Restore_Click"/>
    </StackPanel>
  </Grid>
</Window>
