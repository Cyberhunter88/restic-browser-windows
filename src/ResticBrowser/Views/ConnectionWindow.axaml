<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ResticBrowser.Views.ConnectionWindow"
        Title="Repository öffnen"
        Width="700" Height="760"
        MinWidth="620" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <StackPanel Spacing="3">
      <TextBlock Text="Repository öffnen" Classes="title" />
      <TextBlock Text="Verbindungsdaten werden nur für den Zugriff mit Restic verwendet."
                 Classes="secondary" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Classes="panel" Padding="14">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="Gespeichertes Profil" VerticalAlignment="Center" />
        <ComboBox x:Name="ProfileBox" Grid.Column="1" SelectionChanged="ProfileBox_SelectionChanged" HorizontalAlignment="Stretch" />
        <Button Grid.Column="2" Content="Neues Profil" Click="NewProfile_Click" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="panel" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="Repository" Classes="sectionTitle" />
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9" ColumnSpacing="10">
              <TextBlock Text="Profilname" VerticalAlignment="Center" />
              <TextBox x:Name="NameBox" Grid.Column="1" />

              <TextBlock Grid.Row="1" Text="Verbindungstyp" VerticalAlignment="Center" />
              <ComboBox x:Name="RepoTypeBox" Grid.Row="1" Grid.Column="1" SelectionChanged="RepoTypeBox_SelectionChanged" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Lokaler Ordner oder Netzlaufwerk" IsSelected="True" />
                <ComboBoxItem Content="SFTP über SSH" />
              </ComboBox>

              <TextBlock Grid.Row="2" Text="Speicherort" VerticalAlignment="Top" Margin="0,7,0,0" />
              <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid x:Name="LocalRepoPanel" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                  <TextBox x:Name="RepositoryBox" PlaceholderText="Pfad zum Repository" />
                  <Button Grid.Column="1" Content="Ordner auswählen …" Click="BrowseRepository_Click" />
                </Grid>

                <StackPanel x:Name="SftpPanel" Grid.Row="1" IsVisible="False" Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,80" ColumnSpacing="6">
                    <TextBox x:Name="SftpHostBox" PlaceholderText="Server, z. B. server.example.com" />
                    <TextBlock Grid.Column="1" Text="Port" VerticalAlignment="Center" />
                    <TextBox x:Name="SftpPortBox" Grid.Column="2" Text="22" />
                  </Grid>
                  <TextBox x:Name="SftpUserBox" PlaceholderText="Benutzername" />
                  <TextBox x:Name="SftpPathBox" PlaceholderText="Remote-Pfad, z. B. /var/backups/repo" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="SftpKeyBox" PlaceholderText="SSH-Schlüsseldatei (optional)" />
                    <Button Grid.Column="1" Content="Schlüssel auswählen …" Click="BrowseSftpKey_Click" />
                  </Grid>
                </StackPanel>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="Zugang" Classes="sectionTitle" />
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="9" ColumnSpacing="10">
              <TextBlock Text="Restic-Programm" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="7">
                <TextBox x:Name="ResticBox" />
                <Button Grid.Column="1" Content="Auswählen …" Click="BrowseRestic_Click" />
              </Grid>

              <TextBlock Grid.Row="1" Text="Repository-Passwort" VerticalAlignment="Center" />
              <TextBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" PasswordChar="●" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <StackPanel Spacing="2">
                <TextBlock Text="Backend-Variablen" Classes="sectionTitle" />
                <TextBlock Text="Optional und nur für diese Sitzung" Classes="secondary small" />
              </StackPanel>
              <Button Grid.Column="1" Content="Variable hinzufügen" Click="AddVariable_Click" />
              <Button Grid.Column="2" Content="Auswahl entfernen" Click="RemoveVariable_Click" />
            </Grid>
            <DataGrid x:Name="EnvironmentGrid" Grid.Row="1" AutoGenerateColumns="False" MinHeight="130">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name, z. B. AWS_ACCESS_KEY_ID" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Wert (nur Sitzung)" Binding="{Binding Value}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Abbrechen" Click="Cancel_Click" />
      <Button Classes="primary" Content="Verbinden" Click="Connect_Click" />
    </StackPanel>
  </Grid>
</Window>
