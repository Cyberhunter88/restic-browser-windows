<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ResticBrowser.Models" x:Class="ResticBrowser.MainWindow" Title="Restic Browser" Width="1360" Height="800" MinWidth="960" MinHeight="600" Icon="/Assets/app.ico">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <!-- Top Header & Toolbar -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Image Source="/Assets/app-icon.png" Width="38" Height="38" />
        <StackPanel Spacing="1">
          <TextBlock Text="Restic Browser" FontSize="22" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="Snapshots sicher durchsuchen und wiederherstellen"
                     Foreground="{DynamicResource TextSecondary}"
                     TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsConnected}">
            <TextBlock Text="{Binding RepoStats.SnapshotsCount, StringFormat={}{0:N0} Snapshots}"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="·" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <TextBlock Text="{Binding RepoStats.TotalFileCount, StringFormat={}{0:N0} Dateien}"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="⭐ Lesezeichen" Click="BookmarkMenu_Click" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Gespeicherte Orte öffnen" />
        <Button Content="📊 Speicheranalyse" Click="StorageAnalysis_Click" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Ordnergrößen und Dateitypen des Snapshots analysieren" />
        <Button Content="💽 Mounten" Click="Mount_Click" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Snapshot als virtuelles Laufwerk einbinden" />
        <Button Content="⚖️ Vergleichen" Click="Diff_Click" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Zwei Snapshots miteinander vergleichen" />
        <Button Content="◐ Design" Click="Theme_Click" ToolTip.Tip="Hell/Dunkel umschalten" />
        <Button Content="Aktualisieren" Click="Refresh_Click" IsEnabled="{Binding IsConnected}" />
        <Button Classes="primary" Content="Repository öffnen" Click="Connect_Click" />
        <Button Content="Trennen" Click="Disconnect_Click" IsEnabled="{Binding IsConnected}" />
      </StackPanel>
    </Grid>

    <!-- Main Content Area -->
    <Grid Grid.Row="1" ColumnDefinitions="310,*" ColumnSpacing="14">
      <!-- Left Panel: Snapshots & Filters -->
      <Border Classes="panel" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
          <TextBlock Text="Snapshots" FontSize="16" FontWeight="SemiBold" />
          
          <TextBox Grid.Row="1" PlaceholderText="Snapshot filtern …" Text="{Binding SnapshotFilter, UpdateSourceTrigger=PropertyChanged}" />
          
          <StackPanel Grid.Row="2" Spacing="6">
            <Grid ColumnDefinitions="*,*">
              <ComboBox ItemsSource="{Binding AvailableHosts}" SelectedItem="{Binding FilterHost}" HorizontalAlignment="Stretch" Margin="0,0,3,0"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTags}" SelectedItem="{Binding FilterTag}" HorizontalAlignment="Stretch" Margin="3,0,0,0"/>
            </Grid>
            <CheckBox Content="Nur letzte Sicherung je Host/Pfad" IsChecked="{Binding FilterOnlyLatest}"/>
          </StackPanel>

          <ListBox Grid.Row="3" ItemsSource="{Binding VisibleSnapshots}" SelectedItem="{Binding SelectedSnapshot}" Margin="0,4,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="models:SnapshotInfo">
                <StackPanel Margin="3" Spacing="2">
                  <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Time, StringFormat={}{0:g}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Text="{Binding PathText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Right Main Panel: File Browser -->
      <Border Grid.Column="1" Classes="panel" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
            <Button Content="‹" Click="Back_Click" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Zurück" />
            <Button Grid.Column="1" Content="›" Click="Forward_Click" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Vorwärts" />
            <Button Grid.Column="2" Content="↑" Click="Up_Click" IsEnabled="{Binding CanGoUp}" ToolTip.Tip="Übergeordneter Ordner" />
            <TextBlock Grid.Column="3" Text="{Binding CurrentPath}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="4" Content="⭐ Lesezeichen" Click="AddBookmark_Click" IsEnabled="{Binding IsConnected}" ToolTip.Tip="Diesen Ort als Lesezeichen speichern" />
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="7">
            <TextBox x:Name="SearchBox" PlaceholderText="Dateiname oder Restic-Muster" KeyDown="SearchBox_KeyDown" />
            <Button Grid.Column="1" Content="Suchen" Click="Search_Click" />
          </Grid>

          <DataGrid x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Nodes}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" DoubleTapped="FileList_DoubleTapped">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="👁️ Dateivorschau" Click="Preview_Click"/>
                <MenuItem Header="📥 Auswahl wiederherstellen" Click="Restore_Click"/>
                <Separator/>
                <MenuItem Header="📋 Pfad kopieren" Click="CopyPath_Click"/>
                <MenuItem Header="⭐ Als Lesezeichen speichern" Click="AddBookmark_Click"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="42" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="110" />
              <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="100" />
              <DataGridTextColumn Header="Geändert" Binding="{Binding Modified, StringFormat={}{0:g}}" Width="170" />
              <DataGridTextColumn Header="Berechtigungen" Binding="{Binding Permissions}" Width="130" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="👁️ Dateivorschau" Click="Preview_Click" IsEnabled="{Binding IsConnected}"/>
            <Button Classes="primary" Content="Auswahl wiederherstellen" Click="Restore_Click" IsEnabled="{Binding IsConnected}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer Bar -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0" ColumnSpacing="12">
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="130" Height="5" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <Button Grid.Column="2" Content="Abbrechen" Click="Cancel_Click" IsVisible="{Binding IsBusy}" />
    </Grid>
  </Grid>
</Window>
