<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ResticBrowser.Models" x:Class="ResticBrowser.MainWindow" Title="Restic Browser" Width="1240" Height="760" MinWidth="920" MinHeight="580" Icon="/Assets/app.ico">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
      <StackPanel Orientation="Horizontal" Spacing="12"><Image Source="/Assets/app-icon.png" Width="38" Height="38" /><StackPanel Spacing="2"><TextBlock Text="Restic Browser" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Snapshots sicher durchsuchen und wiederherstellen" Foreground="{DynamicResource TextSecondary}" /></StackPanel></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="◐ Design" Click="Theme_Click" ToolTip.Tip="Hell/Dunkel umschalten" /><Button Content="Aktualisieren" Click="Refresh_Click" IsEnabled="{Binding IsConnected}" /><Button Classes="primary" Content="Repository öffnen" Click="Connect_Click" /><Button Content="Trennen" Click="Disconnect_Click" IsEnabled="{Binding IsConnected}" /></StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="14">
      <Border Classes="panel" Padding="12"><Grid RowDefinitions="Auto,Auto,*" RowSpacing="9"><TextBlock Text="Snapshots" FontSize="16" FontWeight="SemiBold" /><TextBox Grid.Row="1" PlaceholderText="Snapshot filtern …" Text="{Binding SnapshotFilter, UpdateSourceTrigger=PropertyChanged}" /><ListBox Grid.Row="2" ItemsSource="{Binding VisibleSnapshots}" SelectedItem="{Binding SelectedSnapshot}" Margin="0,4,0,0"><ListBox.ItemTemplate><DataTemplate DataType="models:SnapshotInfo"><StackPanel Margin="3" Spacing="2"><TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Time, StringFormat={}{0:g}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" /><TextBlock Text="{Binding PathText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <Border Grid.Column="1" Classes="panel" Padding="12"><Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10"><Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6"><Button Content="‹" Click="Back_Click" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Zurück" /><Button Grid.Column="1" Content="›" Click="Forward_Click" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Vorwärts" /><Button Grid.Column="2" Content="↑" Click="Up_Click" IsEnabled="{Binding CanGoUp}" ToolTip.Tip="Übergeordneter Ordner" /><TextBlock Grid.Column="3" Text="{Binding CurrentPath}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" /></Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="7"><TextBox x:Name="SearchBox" PlaceholderText="Dateiname oder Restic-Muster" KeyDown="SearchBox_KeyDown" /><Button Grid.Column="1" Content="Suchen" Click="Search_Click" /></Grid><DataGrid x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Nodes}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" DoubleTapped="FileList_DoubleTapped"><DataGrid.Columns><DataGridTextColumn Header="" Binding="{Binding Icon}" Width="42" /><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="110" /><DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="100" /><DataGridTextColumn Header="Geändert" Binding="{Binding Modified, StringFormat={}{0:g}}" Width="170" /><DataGridTextColumn Header="Berechtigungen" Binding="{Binding Permissions}" Width="130" /></DataGrid.Columns></DataGrid><Button Grid.Row="3" Classes="primary" Content="Auswahl wiederherstellen" HorizontalAlignment="Right" Click="Restore_Click" IsEnabled="{Binding IsConnected}" /></Grid></Border>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0" ColumnSpacing="12"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" /><ProgressBar Grid.Column="1" Width="130" Height="5" IsIndeterminate="True" IsVisible="{Binding IsBusy}" /><Button Grid.Column="2" Content="Abbrechen" Click="Cancel_Click" IsVisible="{Binding IsBusy}" /></Grid>
  </Grid>
</Window>
