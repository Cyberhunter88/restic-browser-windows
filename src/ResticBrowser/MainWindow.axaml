<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ResticBrowser.Models"
        xmlns:vm="clr-namespace:ResticBrowser.ViewModels"
        x:Class="ResticBrowser.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Restic Browser"
        Width="1360" Height="800"
        MinWidth="760" MinHeight="540"
        Icon="/Assets/app.ico">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Image Source="/Assets/app-icon.png" Width="40" Height="40" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Restic Browser" Classes="title" />
          <TextBlock Text="{CompiledBinding ActiveProfile.Name, TargetNullValue='Sicherungen durchsuchen und wiederherstellen', FallbackValue='Sicherungen durchsuchen und wiederherstellen'}"
                     Classes="secondary" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="quiet" Content="Design" Click="Theme_Click"
                ToolTip.Tip="Zwischen hellem und dunklem Design wechseln"
                AutomationProperties.Name="Design wechseln" />
        <Button Classes="quiet" Content="Trennen" Click="Disconnect_Click" IsVisible="{CompiledBinding IsConnected}" />
        <Button Classes="primary" Content="Repository öffnen" Click="Connect_Click"
                IsVisible="{CompiledBinding IsDisconnected}" ToolTip.Tip="Repository öffnen (Strg+O)" />
        <Button Content="Repository wechseln" Click="Connect_Click"
                IsVisible="{CompiledBinding IsConnected}" ToolTip.Tip="Anderes Repository öffnen (Strg+O)" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="toolbar" Padding="10,8">
      <WrapPanel Classes="repositoryTools">
          <Button Classes="quiet" Content="Aktualisieren" Click="Refresh_Click" IsEnabled="{CompiledBinding IsConnected}"
                  ToolTip.Tip="Snapshot-Liste neu laden (F5)" />
          <Separator Width="1" Height="24" />
          <TextBlock Text="Werkzeuge" Classes="secondary small" VerticalAlignment="Center" Margin="6,0,2,0" />
          <Button Classes="quiet" Content="Speicheranalyse" Click="StorageAnalysis_Click" IsEnabled="{CompiledBinding IsConnected}"
                  ToolTip.Tip="Ordnergrößen und Dateitypen des gewählten Snapshots analysieren" />
          <Button Classes="quiet" Content="Repository prüfen" Click="Check_Click" IsEnabled="{CompiledBinding IsConnected}" />
          <Button x:Name="MountButton" Classes="quiet" Content="Als Laufwerk einbinden" Click="Mount_Click"
                  IsEnabled="{CompiledBinding IsConnected}" ToolTip.Tip="Unter Linux als virtuelles Laufwerk einbinden" />
      </WrapPanel>
    </Border>

    <Grid x:Name="BrowserGrid" Grid.Row="2" IsEnabled="{CompiledBinding IsConnected}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>
      <Border Classes="panel" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Snapshots" Classes="sectionTitle" />
              <TextBlock Text="{CompiledBinding VisibleSnapshots.Count, StringFormat={}{0:N0} angezeigt}" Classes="secondary small" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{CompiledBinding Snapshots.Count, StringFormat={}Gesamt: {0:N0}}"
                       Classes="secondary small" VerticalAlignment="Center" />
          </Grid>

          <Expander Grid.Row="1" Header="Snapshots filtern">
            <StackPanel Spacing="8" Margin="0,8,0,2">
              <TextBox PlaceholderText="Host, Pfad, Tag oder ID" Text="{CompiledBinding SnapshotFilter, UpdateSourceTrigger=PropertyChanged}" />
              <ComboBox ItemsSource="{CompiledBinding AvailableHosts}" SelectedItem="{CompiledBinding FilterHost}" HorizontalAlignment="Stretch" />
              <ComboBox ItemsSource="{CompiledBinding AvailableTags}" SelectedItem="{CompiledBinding FilterTag}" HorizontalAlignment="Stretch" />
              <CheckBox IsChecked="{CompiledBinding FilterOnlyLatest}">
                <TextBlock Text="Nur letzte Sicherung je Host und Pfad" TextWrapping="Wrap" />
              </CheckBox>
            </StackPanel>
          </Expander>

          <ListBox Grid.Row="2" ItemsSource="{CompiledBinding VisibleSnapshots}" SelectedItem="{CompiledBinding SelectedSnapshot}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:SnapshotInfo">
                <StackPanel Margin="4,5" Spacing="3" ToolTip.Tip="{CompiledBinding ExactTimeText}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{CompiledBinding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{CompiledBinding DisplayId}" Classes="secondary small" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{CompiledBinding Time, StringFormat={}{0:g}}" Classes="secondary small" />
                    <TextBlock Grid.Column="1" Text="{CompiledBinding RelativeTimeText}" Classes="secondary small" />
                  </Grid>
                  <TextBlock Text="{CompiledBinding PathText}" Classes="secondary small" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="14" Background="Transparent" ResizeDirection="Columns"
                    ToolTip.Tip="Breite der Snapshot-Liste ändern"
                    AutomationProperties.Name="Trenner zwischen Snapshot-Liste und Dateibrowser" />

      <Border Grid.Column="2" Classes="panel" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
            <Button Content="‹" Click="Back_Click" IsEnabled="{CompiledBinding CanGoBack}" ToolTip.Tip="Zurück (Alt+←)"
                    AutomationProperties.Name="Zurück" />
            <Button Grid.Column="1" Content="›" Click="Forward_Click" IsEnabled="{CompiledBinding CanGoForward}" ToolTip.Tip="Vorwärts (Alt+→)"
                    AutomationProperties.Name="Vorwärts" />
            <Button Grid.Column="2" Content="↑" Click="Up_Click" IsEnabled="{CompiledBinding CanGoUp}" ToolTip.Tip="Übergeordneter Ordner (Alt+↑)"
                    AutomationProperties.Name="Übergeordneter Ordner" />
            <StackPanel Grid.Column="3" Margin="8,0" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Dateien" Classes="sectionTitle" />
              <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                            ToolTip.Tip="{CompiledBinding CurrentPath}">
                <ItemsControl ItemsSource="{CompiledBinding PathSegments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PathSegment">
                      <Button Classes="quiet" Padding="6,1" MinHeight="22" FontSize="12" Content="{CompiledBinding Display}"
                              Click="Crumb_Click" Tag="{CompiledBinding Path}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
            <TextBlock Grid.Column="4" Text="{CompiledBinding Nodes.Count, StringFormat={}{0:N0} Einträge}"
                       Classes="secondary small" VerticalAlignment="Center" />
          </Grid>

          <Grid x:Name="SearchGrid" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="7" RowSpacing="7">
            <TextBox x:Name="SearchBox" PlaceholderText="Dateiname oder Restic-Muster suchen (Strg+F)" KeyDown="SearchBox_KeyDown" />
            <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
              <ComboBox x:Name="SearchScopeBox" SelectedIndex="0" MinWidth="170"
                        ToolTip.Tip="Wo gesucht wird" AutomationProperties.Name="Suchbereich">
                <ComboBoxItem>Dieser Snapshot</ComboBoxItem>
                <ComboBoxItem>Neueste Version (alle)</ComboBoxItem>
              </ComboBox>
              <Button Content="Suchen" Click="Search_Click" />
              <Button Classes="quiet" Content="×" Click="ClearSearch_Click" ToolTip.Tip="Suche zurücksetzen"
                      AutomationProperties.Name="Suche zurücksetzen" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <DataGrid x:Name="FileList" ItemsSource="{CompiledBinding Nodes}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True"
                      DoubleTapped="FileList_DoubleTapped" SelectionChanged="FileList_SelectionChanged">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Vorschau öffnen" Click="Preview_Click" InputGesture="Enter" />
                  <MenuItem Header="Versionen anzeigen" Click="Versions_Click" />
                  <MenuItem Header="Auswahl wiederherstellen" Click="Restore_Click" InputGesture="Ctrl+R" />
                  <Separator />
                  <MenuItem Header="Pfad kopieren" Click="CopyPath_Click" />
                  <MenuItem x:Name="PermissionsMenuItem" Header="Spalte „Berechtigungen“" ToggleType="CheckBox"
                            Click="TogglePermissions_Click" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn x:DataType="models:BackupNode" Header="" Binding="{CompiledBinding Icon}" Width="40" CanUserSort="False" />
                <DataGridTextColumn x:DataType="models:BackupNode" Header="Name" Binding="{CompiledBinding Name}" Width="*" MinWidth="120" />
                <DataGridTextColumn x:DataType="models:BackupNode" Header="Typ" Binding="{CompiledBinding TypeText}" Width="100" />
                <DataGridTextColumn x:DataType="models:BackupNode" Header="Größe" Binding="{CompiledBinding SizeText}" Width="100" />
                <DataGridTextColumn x:DataType="models:BackupNode" Header="Geändert" Binding="{CompiledBinding Modified, StringFormat={}{0:g}}" Width="160" />
                <DataGridTextColumn x:DataType="models:BackupNode" Header="Berechtigungen" Binding="{CompiledBinding Permissions}" Width="130" IsVisible="False" />
              </DataGrid.Columns>
            </DataGrid>
            <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True" IsHitTestVisible="False"
                         IsVisible="{CompiledBinding IsBusy}" />
          </Grid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Vorschau" Click="Preview_Click" IsEnabled="{CompiledBinding IsConnected}" />
            <Button Content="Versionen" Click="Versions_Click" IsEnabled="{CompiledBinding IsConnected}" />
            <Button Classes="primary" Content="Auswahl wiederherstellen" Click="Restore_Click" IsEnabled="{CompiledBinding IsConnected}"
                    ToolTip.Tip="Ausgewählte Dateien wiederherstellen (Strg+R)" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="panel" Padding="24" IsVisible="{CompiledBinding IsDisconnected}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="460">
        <TextBlock Text="Noch kein Repository geöffnet" Classes="title" HorizontalAlignment="Center" />
        <TextBlock Text="Öffne ein vorhandenes Restic-Repository, um Snapshots zu durchsuchen und Dateien wiederherzustellen. Das Repository wird nur gelesen."
                   Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Classes="primary" Content="Repository öffnen" Click="Connect_Click" HorizontalAlignment="Center" />
        <StackPanel x:Name="RecentPanel" Spacing="6" IsVisible="False">
          <TextBlock Text="Gespeicherte Profile" Classes="sectionTitle" HorizontalAlignment="Center" />
          <ItemsControl ItemsSource="{CompiledBinding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:RepositoryProfile">
                <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="RecentProfile_Click" Content="{CompiledBinding Name}" ToolTip.Tip="{CompiledBinding Repository}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
      <TextBlock Text="{CompiledBinding Status}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="{CompiledBinding SelectionSummary}" Classes="secondary" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="2" Width="140" Height="5" IsIndeterminate="True" IsVisible="{CompiledBinding IsBusy}" />
      <Button Grid.Column="3" Content="Vorgang abbrechen" Click="Cancel_Click" IsVisible="{CompiledBinding IsBusy}"
              ToolTip.Tip="Laufenden Vorgang abbrechen (Esc)" />
    </Grid>
  </Grid>
</Window>
