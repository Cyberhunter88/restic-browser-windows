<Window x:Class="ResticBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ResticBrowser.Models"
        Title="Restic Browser" Width="1420" Height="850" MinWidth="1050" MinHeight="650"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="38"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="R" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="11,0,0,0">
            <TextBlock Text="Restic Browser" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ActiveProfile.Name, TargetNullValue=Kein Repository verbunden}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="◐ Design" Click="Theme_Click" ToolTip="Hell/Dunkel umschalten"/>
          <Button Content="Aktualisieren" Click="Refresh_Click" IsEnabled="{Binding IsConnected}"/>
          <Button Content="Repository öffnen" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
          <Button Content="Trennen" Click="Disconnect_Click" IsEnabled="{Binding IsConnected}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="290"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Margin="16,15,16,8" Text="Snapshots" FontWeight="SemiBold" FontSize="16"/>
          <TextBox Grid.Row="1" Margin="12,4,12,8" Text="{Binding SnapshotFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nach Host, Pfad, Tag oder ID filtern"/>
          <ListBox Grid.Row="2" Margin="8" ItemsSource="{Binding VisibleSnapshots}" SelectedItem="{Binding SelectedSnapshot}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:SnapshotInfo}">
                <Border Padding="7">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Time, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding DisplayId}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Hostname}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding PathText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/>
                    <DockPanel Margin="0,4,0,0">
                      <TextBlock Text="{Binding TagText}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button Content="‹" Click="Back_Click" IsEnabled="{Binding CanGoBack}" Padding="11,7" ToolTip="Zurück"/>
              <Button Content="›" Click="Forward_Click" IsEnabled="{Binding CanGoForward}" Padding="11,7" ToolTip="Vorwärts"/>
              <Button Content="↑" Click="Up_Click" IsEnabled="{Binding CanGoUp}" Padding="11,7" ToolTip="Übergeordneter Ordner"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="6,3" Padding="10,6" CornerRadius="6" Background="{DynamicResource PanelAltBackground}">
              <TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <TextBox x:Name="SearchBox" Grid.Column="2" Margin="5,3" KeyDown="SearchBox_KeyDown" ToolTip="Dateiname oder Restic-Muster"/>
            <Button Grid.Column="3" Content="Suchen" Click="Search_Click"/>
          </Grid>
          <Separator Grid.Row="1" Background="{DynamicResource BorderBrush}"/>
          <ListView x:Name="FileList" Grid.Row="2" Margin="7" ItemsSource="{Binding Nodes}"
                    SelectedItem="{Binding SelectedNode}" SelectionMode="Extended"
                    MouseDoubleClick="FileList_DoubleClick">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Name" Width="360">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}"/>
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Typ" Width="110" DisplayMemberBinding="{Binding TypeText}"/>
                <GridViewColumn Header="Größe" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                <GridViewColumn Header="Geändert" Width="165" DisplayMemberBinding="{Binding Modified, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Column="4" CornerRadius="10" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="17">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Details" FontWeight="SemiBold" FontSize="16"/>
          <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="{Binding SelectedNode.Icon}" FontSize="42" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding SelectedNode.Name, TargetNullValue=Kein Element ausgewählt}" Margin="0,9,0,18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="Typ" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedNode.TypeText, TargetNullValue=—}" Margin="0,2,0,12"/>
            <TextBlock Text="Größe" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedNode.SizeText, TargetNullValue=—}" Margin="0,2,0,12"/>
            <TextBlock Text="Geändert" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedNode.Modified, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}, TargetNullValue=—}" Margin="0,2,0,12"/>
            <TextBlock Text="Berechtigungen" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedNode.Permissions, TargetNullValue=—}" Margin="0,2,0,12"/>
            <TextBlock Text="Snapshot-Pfad" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Text="{Binding SelectedNode.Path, TargetNullValue=—}" Margin="0,2,0,12" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Row="2" Content="Auswahl wiederherstellen" Style="{StaticResource PrimaryButton}" Click="Restore_Click" IsEnabled="{Binding IsConnected}"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="16,0">
        <ProgressBar Width="130" Height="4" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <Button DockPanel.Dock="Right" Content="Abbrechen" Padding="9,3" Click="Cancel_Click" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
