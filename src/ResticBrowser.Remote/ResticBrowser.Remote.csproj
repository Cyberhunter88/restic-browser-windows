<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResticBrowser.Remote</AssemblyName>
    <RootNamespace>ResticBrowser.RemoteHost</RootNamespace>
    <Version>$(ResticBrowserProductVersion)</Version>
    <AssemblyVersion>$(ResticBrowserAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ResticBrowserAssemblyVersion)</FileVersion>
    <InformationalVersion>$(ResticBrowserProductVersion)</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ResticBrowser\Remote\RemoteProtocol.cs" Link="RemoteProtocol.cs" />
  </ItemGroup>
</Project>
